{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capabilities for mobile platforms",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/Downloads/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "dialog:allow-open"
  ]
}
